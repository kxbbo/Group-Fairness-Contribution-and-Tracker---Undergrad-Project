#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader or built-in standalone compatibility engine
if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require __DIR__.'/vendor/autoload.php';
    $app = require_once __DIR__.'/bootstrap/app.php';
    $status = $app->handleCommand(new Symfony\Component\Console\Input\ArgvInput);
    exit($status);
} else {
    require_once __DIR__.'/bootstrap/standalone_engine.php';
    exit(handleStandaloneArtisan($argv));
}
